// KhetMitra data model. Connection URL lives in prisma.config.ts (Prisma 7).
// Vector columns are `Unsupported`, so they are read/written only via raw SQL (src/db/vector.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Farmer {
  id           String   @id @default(cuid())
  name         String?
  language     String   @default("hi")
  locationName String   @map("location_name")
  latitude     Float
  longitude    Float
  state        String?
  district     String?
  /// Values the farmer copied from their Soil Health Card, with the test date.
  soilCard     Json?    @map("soil_card")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  crops         FarmerCrop[]
  conversations Conversation[]
  alerts        Alert[]

  @@map("farmers")
}

model FarmerCrop {
  id         String   @id @default(cuid())
  farmerId   String   @map("farmer_id")
  crop       String
  sowingDate DateTime @map("sowing_date") @db.Date
  areaAcres  Float?   @map("area_acres")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@unique([farmerId, crop])
  @@map("farmer_crops")
}

model Conversation {
  id        String   @id @default(cuid())
  farmerId  String?  @map("farmer_id")
  language  String
  createdAt DateTime @default(now()) @map("created_at")

  farmer   Farmer?     @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  messages Message[]
  steps    AgentStep[]

  @@index([farmerId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  /// "user" | "assistant"
  role           String
  content        String
  citations      Json?
  /// Result of the grounding guardrail for assistant messages.
  guardrail      Json?
  turnId         String?  @map("turn_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// One row per agent step (LLM call, tool call, guardrail, error). Powers the trace panel.
model AgentStep {
  id             String   @id @default(cuid())
  conversationId String?  @map("conversation_id")
  turnId         String   @map("turn_id")
  stepIndex      Int      @map("step_index")
  /// "llm" | "tool" | "guardrail" | "error"
  kind           String
  /// Model id for llm steps, tool name for tool steps.
  name           String
  args           Json?
  resultSummary  String?  @map("result_summary")
  latencyMs      Int      @map("latency_ms")
  attempt        Int      @default(1)
  error          String?
  promptVersion  String?  @map("prompt_version")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([conversationId])
  @@map("agent_steps")
}

model AdvisoryDocument {
  /// Source id from config/advisory-sources.ts.
  id             String   @id
  title          String
  publisher      String
  url            String
  region         String
  language       String
  crops          String[]
  contentHash    String   @map("content_hash")
  /// Chunks are only comparable with query embeddings from the same model.
  embeddingModel String   @map("embedding_model")
  pageCount      Int?     @map("page_count")
  fetchedAt      DateTime @map("fetched_at")

  chunks AdvisoryChunk[]

  @@map("advisory_documents")
}

model AdvisoryChunk {
  id            String                     @id @default(cuid())
  documentId    String                     @map("document_id")
  chunkIndex    Int                        @map("chunk_index")
  section       String?
  pageFrom      Int?                       @map("page_from")
  pageTo        Int?                       @map("page_to")
  /// Crop ids this chunk applies to, or ["all"].
  crops         String[]
  content       String
  tokenEstimate Int                        @map("token_estimate")
  embedding     Unsupported("vector(768)")

  document AdvisoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("advisory_chunks")
}

/// Raw responses from external APIs, served as labelled "cached" data when a provider fails.
model ApiCache {
  key       String   @id
  source    String
  payload   Json
  fetchedAt DateTime @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("api_cache")
}

/// Every real Agmarknet price row KhetMitra has fetched; the price trend is computed from this.
model MandiPrice {
  id          String   @id @default(cuid())
  state       String
  district    String
  market      String
  commodity   String
  variety     String
  grade       String
  arrivalDate DateTime @map("arrival_date") @db.Date
  minPrice    Float    @map("min_price")
  maxPrice    Float    @map("max_price")
  modalPrice  Float    @map("modal_price")
  source      String
  fetchedAt   DateTime @map("fetched_at")

  @@unique([state, district, market, commodity, variety, grade, arrivalDate])
  @@index([commodity, state, district, arrivalDate])
  @@map("mandi_prices")
}

model Alert {
  id        String    @id @default(cuid())
  farmerId  String    @map("farmer_id")
  crop      String
  /// Rule that fired, e.g. "heavy_rain", "rain_before_inputs", "heat_stress", "cold_stress", "strong_wind".
  kind      String
  /// "info" | "warning" | "severe"
  severity  String
  title     String
  message   String
  eventDate DateTime  @map("event_date") @db.Date
  /// Forecast values that triggered the rule, with their source and fetch time.
  evidence  Json
  citations Json
  turnId    String?   @map("turn_id")
  /// farmer + crop + rule + event date: one alert per event even if the check runs hourly.
  dedupeKey String    @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, createdAt])
  @@map("alerts")
}
