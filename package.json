{
  "name": "khetmitra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-first multilingual farm advisory assistant grounded in live weather, mandi prices, soil data and official advisories.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "probe": "node --env-file-if-exists=.env --import tsx scripts/probe/run-all.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@ai-sdk/openai": "^4.0.106",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "^7.0.159",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "node-html-parser": "^9.0.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
