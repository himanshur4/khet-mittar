# KhetMitra configuration. Copy to `.env` and fill in the keys.
# Any missing key only disables its feature; /api/health lists what is missing.

# --- Database (required) -----------------------------------------------------
# Local: `docker compose up -d` matches this URL. Production: your Neon connection string.
DATABASE_URL=postgresql://khetmitra:khetmitra@localhost:5433/khetmitra

# --- LLM (required for chat + alerts) ----------------------------------------
# google | openai
LLM_PROVIDER=google
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys (only needed if LLM_PROVIDER=openai or as fallback)
OPENAI_API_KEY=
# Optional overrides (defaults live in src/core/agent/models.ts)
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# Embeddings default to the LLM provider. Changing provider/model requires re-running `npm run ingest`.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Live data ---------------------------------------------------------------
# data.gov.in (Agmarknet mandi prices): sign in at https://data.gov.in → My Account → API key
DATA_GOV_IN_API_KEY=
# Optional: override the Agmarknet resource id (default is set in src/core/tools/mandi/client.ts)
MANDI_RESOURCE_ID=

# --- Speech + translation ----------------------------------------------------
# Sarvam AI: https://dashboard.sarvam.ai (API Keys)
SARVAM_API_KEY=

# --- Proactive alerts --------------------------------------------------------
# Random string (>= 16 chars). Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# debug | info | warn | error
LOG_LEVEL=info
